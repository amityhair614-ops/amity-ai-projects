 "subtitles": [
  {
   "text": "セルフカットに使うすきバサミ",
   "outStart": 1.2,
   "outEnd": 2.93,
   "srcStart": 2.03,
   "srcEnd": 3.77,
   "chars": 14
  },
  {
   "text": "何を基準に選べば良いのか",
   "outStart": 3.1,
   "outEnd": 5.27,
   "srcStart": 3.93,
   "srcEnd": 6.11,
   "chars": 12
  },
  {
   "text": "すき量",
   "outStart": 5.67,
   "outEnd": 6.9,
   "srcStart": 6.5,
   "srcEnd": 7.74,
   "chars": 3
  },
  {
   "text": "すき量15%のものを使ってください",
   "outStart": 7.07,
   "outEnd": 10.4,
   "srcStart": 8.1,
   "srcEnd": 11.44,
   "chars": 17
  },
  {
   "text": "パーセンテージが高ければ高いほど、",
   "outStart": 10.7,
   "outEnd": 13.57,
   "srcStart": 11.73,
   "srcEnd": 14.61,
   "chars": 16
  },
  {
   "text": "一度すきバサミを入れた",
   "outStart": 14.1,
   "outEnd": 16.4,
   "srcStart": 15.13,
   "srcEnd": 17.44,
   "chars": 11
  },
  {
   "text": "ドカーッと軽くなってしまいます",
   "outStart": 16.4,
   "outEnd": 18.13,
   "srcStart": 17.43,
   "srcEnd": 19.17,
   "chars": 15
  },
  {
   "text": "逆に低いもの",
   "outStart": 18.37,
   "outEnd": 20.27,
   "srcStart": 19.4,
   "srcEnd": 21.27,
   "chars": 6
  },
  {
   "text": "10%や5%のもの",
   "outStart": 20.27,
   "outEnd": 22.7,
   "srcStart": 21.27,
   "srcEnd": 23.74,
   "chars": 9
  },
  {
   "text": "1度ハサミを入れた",
   "outStart": 23.2,
   "outEnd": 25.63,
   "srcStart": 24.23,
   "srcEnd": 26.67,
   "chars": 9
  },
  {
   "text": "あまり変化が感じられないです。",
   "outStart": 25.63,
   "outEnd": 27.87,
   "srcStart": 26.67,
   "srcEnd": 28.91,
   "chars": 15
  },
  {
   "text": "15%のものを使ってください",
   "outStart": 27.87,
   "outEnd": 31.43,
   "srcStart": 28.9,
   "srcEnd": 32.47,
   "chars": 14
  },
  {
   "text": "価格は2000円以上なものを選んでください",
   "outStart": 31.77,
   "outEnd": 36.1,
   "srcStart": 32.8,
   "srcEnd": 37.14,
   "chars": 21
  },
  {
   "text": "セットで2000円というわけではなく、",
   "outStart": 36.47,
   "outEnd": 38.43,
   "srcStart": 37.5,
   "srcEnd": 39.47,
   "chars": 18
  },
  {
   "text": "すきバサミ単体で2000円以上なものがベスト",
   "outStart": 38.9,
   "outEnd": 42.9,
   "srcStart": 39.93,
   "srcEnd": 43.94,
   "chars": 22
  },
  {
   "text": "100均のものは使わない方が良いです",
   "outStart": 43.8,
   "outEnd": 46.8,
   "srcStart": 45.3,
   "srcEnd": 53.61,
   "chars": 18
  },
  {
   "text": "参考にすきバサミを選んでみてください",
   "outStart": 46.97,
   "outEnd": 49.4,
   "srcStart": 53.77,
   "srcEnd": 56.81,
   "chars": 18
  }
 ],
