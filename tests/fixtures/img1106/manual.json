 "subtitles": [
  {
   "text": "セルフカットで",
   "outStart": 1.17,
   "outEnd": 1.97,
   "srcStart": 4.43,
   "srcEnd": 5.24,
   "chars": 7
  },
  {
   "text": "梳きバサミを使って",
   "outStart": 1.97,
   "outEnd": 3.6,
   "srcStart": 5.23,
   "srcEnd": 6.87,
   "chars": 9
  },
  {
   "text": "髪の量を軽くする際",
   "outStart": 3.6,
   "outEnd": 5.5,
   "srcStart": 6.87,
   "srcEnd": 8.84,
   "chars": 9
  },
  {
   "text": "根元付近から",
   "outStart": 5.73,
   "outEnd": 7.2,
   "srcStart": 11.47,
   "srcEnd": 12.94,
   "chars": 6
  },
  {
   "text": "軽くするとどうなってしまうのか",
   "outStart": 7.2,
   "outEnd": 10.03,
   "srcStart": 12.93,
   "srcEnd": 16.01,
   "chars": 15
  },
  {
   "text": "髪の量が",
   "outStart": 10.5,
   "outEnd": 11.1,
   "srcStart": 18.8,
   "srcEnd": 19.41,
   "chars": 4
  },
  {
   "text": "すごく軽く感じます",
   "outStart": 11.1,
   "outEnd": 13.2,
   "srcStart": 19.4,
   "srcEnd": 21.54,
   "chars": 9
  },
  {
   "text": "こんなことが起こります",
   "outStart": 14.17,
   "outEnd": 15.9,
   "srcStart": 22.9,
   "srcEnd": 28.57,
   "chars": 11
  },
  {
   "text": "根元近くから",
   "outStart": 15.93,
   "outEnd": 16.9,
   "srcStart": 28.6,
   "srcEnd": 29.57,
   "chars": 6
  },
  {
   "text": "ピンピンした髪の毛が",
   "outStart": 16.9,
   "outEnd": 18.4,
   "srcStart": 29.57,
   "srcEnd": 31.07,
   "chars": 10
  },
  {
   "text": "たくさんできてきます",
   "outStart": 18.4,
   "outEnd": 20.33,
   "srcStart": 31.07,
   "srcEnd": 33.44,
   "chars": 10
  },
  {
   "text": "まとまらない",
   "outStart": 21.53,
   "outEnd": 23.5,
   "srcStart": 34.63,
   "srcEnd": 36.61,
   "chars": 6
  },
  {
   "text": "変なボリューム感",
   "outStart": 23.5,
   "outEnd": 25.53,
   "srcStart": 36.9,
   "srcEnd": 38.94,
   "chars": 8
  },
  {
   "text": "ヘアスタイルのバランスがおかしい",
   "outStart": 25.6,
   "outEnd": 28.43,
   "srcStart": 39.0,
   "srcEnd": 47.87,
   "chars": 16
  },
  {
   "text": "良くないことがたくさん起こってしまいます",
   "outStart": 29.23,
   "outEnd": 32.33,
   "srcStart": 49.03,
   "srcEnd": 52.57,
   "chars": 20
  },
  {
   "text": "梳きバサミを入れるのはやめてください",
   "outStart": 34.3,
   "outEnd": 37.8,
   "srcStart": 56.7,
   "srcEnd": 60.21,
   "chars": 18
  },
  {
   "text": "トップ表面辺りは必ずそれを守ってください",
   "outStart": 38.7,
   "outEnd": 43.3,
   "srcStart": 61.1,
   "srcEnd": 66.11,
   "chars": 20
  },
  {
   "text": "やってしまうと取り返しがつかないです",
   "outStart": 43.37,
   "outEnd": 45.17,
   "srcStart": 66.17,
   "srcEnd": 67.97,
   "chars": 18
  },
  {
   "text": "修正カットするのに",
   "outStart": 45.7,
   "outEnd": 47.33,
   "srcStart": 68.5,
   "srcEnd": 70.14,
   "chars": 9
  },
  {
   "text": "半年以上",
   "outStart": 47.33,
   "outEnd": 48.93,
   "srcStart": 70.13,
   "srcEnd": 71.74,
   "chars": 4
  },
  {
   "text": "なにもせずに",
   "outStart": 49.13,
   "outEnd": 50.1,
   "srcStart": 71.93,
   "srcEnd": 72.91,
   "chars": 6
  },
  {
   "text": "伸ばし続けなければならないです",
   "outStart": 50.1,
   "outEnd": 52.97,
   "srcStart": 72.9,
   "srcEnd": 78.34,
   "chars": 15
  },
  {
   "text": "根元付近に梳きバサミを入れるのはやめてください",
   "outStart": 53.1,
   "outEnd": 56.03,
   "srcStart": 78.47,
   "srcEnd": 81.41,
   "chars": 23
  }
 ],
 "spoken": [
