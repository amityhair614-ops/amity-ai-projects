 "subtitles": [
  {
   "text": "セルフカットで",
   "outStart": 1.0,
   "outEnd": 2.0,
   "srcStart": 1.6,
   "srcEnd": 2.6,
   "chars": 7
  },
  {
   "text": "伸びて重くなったボブを",
   "outStart": 2.0,
   "outEnd": 3.93,
   "srcStart": 2.6,
   "srcEnd": 4.53,
   "chars": 11
  },
  {
   "text": "軽くした後に",
   "outStart": 3.93,
   "outEnd": 5.57,
   "srcStart": 4.53,
   "srcEnd": 6.17,
   "chars": 6
  },
  {
   "text": "重さを感じやすい理由",
   "outStart": 5.77,
   "outEnd": 8.83,
   "srcStart": 6.37,
   "srcEnd": 9.43,
   "chars": 10
  },
  {
   "text": "それは表面の髪が長いからです",
   "outStart": 9.17,
   "outEnd": 13.47,
   "srcStart": 10.17,
   "srcEnd": 14.47,
   "chars": 14
  },
  {
   "text": "ボブは表面の長さと下の長さが同じぐらいです",
   "outStart": 13.77,
   "outEnd": 19.67,
   "srcStart": 15.17,
   "srcEnd": 21.07,
   "chars": 21
  },
  {
   "text": "それもあって重さを感じやすいです",
   "outStart": 19.87,
   "outEnd": 22.83,
   "srcStart": 21.27,
   "srcEnd": 21.53,
   "chars": 16
  },
  {
   "text": "段がついていない",
   "outStart": 22.87,
   "outEnd": 24.27,
   "srcStart": 24.9,
   "srcEnd": 26.3,
   "chars": 8
  },
  {
   "text": "レイヤーがついていないので",
   "outStart": 24.27,
   "outEnd": 26.8,
   "srcStart": 26.3,
   "srcEnd": 28.83,
   "chars": 13
  },
  {
   "text": "動きが出しにくい",
   "outStart": 27.27,
   "outEnd": 30.23,
   "srcStart": 29.3,
   "srcEnd": 32.26,
   "chars": 8
  },
  {
   "text": "まとまりやすいメリットはあります",
   "outStart": 31.0,
   "outEnd": 34.43,
   "srcStart": 33.7,
   "srcEnd": 37.13,
   "chars": 16
  },
  {
   "text": "もしボブを軽くして",
   "outStart": 34.43,
   "outEnd": 36.9,
   "srcStart": 37.93,
   "srcEnd": 40.4,
   "chars": 9
  },
  {
   "text": "重くて仕方ない",
   "outStart": 36.9,
   "outEnd": 38.77,
   "srcStart": 40.4,
   "srcEnd": 42.27,
   "chars": 7
  },
  {
   "text": "段を入れる必要があります",
   "outStart": 39.77,
   "outEnd": 42.0,
   "srcStart": 43.27,
   "srcEnd": 45.5,
   "chars": 12
  },
  {
   "text": "でもレイヤーを入れるとなると",
   "outStart": 42.0,
   "outEnd": 45.27,
   "srcStart": 45.5,
   "srcEnd": 48.77,
   "chars": 14
  },
  {
   "text": "セルフではかなり難しいです",
   "outStart": 45.27,
   "outEnd": 48.27,
   "srcStart": 48.77,
   "srcEnd": 51.77,
   "chars": 13
  },
  {
   "text": "美容室に行ってカットしてもらう方が",
   "outStart": 48.9,
   "outEnd": 51.8,
   "srcStart": 53.2,
   "srcEnd": 56.1,
   "chars": 17
  },
  {
   "text": "思い通りのスタイルになっていきます",
   "outStart": 51.8,
   "outEnd": 54.63,
   "srcStart": 56.1,
   "srcEnd": 58.87,
   "chars": 17
  },
  {
   "text": "そもそもボブは重めなスタイル",
   "outStart": 54.6,
   "outEnd": 57.83,
   "srcStart": 59.36,
   "srcEnd": 62.59,
   "chars": 14
  },
  {
   "text": "セルフカットをやってみてください",
   "outStart": 59.73,
   "outEnd": 62.4,
   "srcStart": 64.49,
   "srcEnd": 67.16,
   "chars": 16
  }
 ],
