   "outEnd": 45.2,
   "srcStart": 45.23,
   "srcEnd": 47.24,
   "chars": 7
  },
  {
   "text": "入れていくようにやっていきましょう",
   "outStart": 45.2,
   "outEnd": 47.23,
   "srcStart": 47.23,
   "srcEnd": 49.31,
   "chars": 17
  },
  {
   "text": "グラデーションのように",
