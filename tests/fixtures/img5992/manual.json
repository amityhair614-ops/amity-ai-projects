 "subtitles": [
  {
   "text": "セルフカットで",
   "outStart": 1.0,
   "outEnd": 2.1,
   "srcStart": 1.93,
   "srcEnd": 3.07,
   "chars": 7
  },
  {
   "text": "伸びて重くなった髪を",
   "outStart": 2.1,
   "outEnd": 4.23,
   "srcStart": 3.07,
   "srcEnd": 5.21,
   "chars": 10
  },
  {
   "text": "すきバサミで軽くしていく際",
   "outStart": 4.23,
   "outEnd": 6.93,
   "srcStart": 5.2,
   "srcEnd": 7.91,
   "chars": 13
  },
  {
   "text": "同じ場所に",
   "outStart": 7.37,
   "outEnd": 8.07,
   "srcStart": 8.4,
   "srcEnd": 9.14,
   "chars": 5
  },
  {
   "text": "何度も入れないようにしましょう",
   "outStart": 8.07,
   "outEnd": 10.67,
   "srcStart": 9.13,
   "srcEnd": 11.74,
   "chars": 15
  },
  {
   "text": "もし何度も同じ場所に",
   "outStart": 11.03,
   "outEnd": 13.67,
   "srcStart": 12.07,
   "srcEnd": 14.71,
   "chars": 10
  },
  {
   "text": "入れてしまうと",
   "outStart": 13.67,
   "outEnd": 15.0,
   "srcStart": 14.7,
   "srcEnd": 16.04,
   "chars": 7
  },
  {
   "text": "必ずスカスカになってしまいます",
   "outStart": 15.0,
   "outEnd": 17.27,
   "srcStart": 16.03,
   "srcEnd": 18.51,
   "chars": 15
  },
  {
   "text": "こうなると取り返しがつかないです",
   "outStart": 17.47,
   "outEnd": 19.57,
   "srcStart": 18.67,
   "srcEnd": 20.77,
   "chars": 16
  },
  {
   "text": "髪の毛が伸びないと修正が効かないです",
   "outStart": 19.7,
   "outEnd": 23.17,
   "srcStart": 20.93,
   "srcEnd": 24.37,
   "chars": 18
  },
  {
   "text": "下手すれば",
   "outStart": 23.43,
   "outEnd": 24.13,
   "srcStart": 24.67,
   "srcEnd": 25.34,
   "chars": 5
  },
  {
   "text": "半年以上伸ばさないとうまくいかないです",
   "outStart": 24.13,
   "outEnd": 28.53,
   "srcStart": 25.33,
   "srcEnd": 29.74,
   "chars": 19
  },
  {
   "text": "ではどうやって軽くするのがベストなのか",
   "outStart": 28.7,
   "outEnd": 33.1,
   "srcStart": 30.47,
   "srcEnd": 35.17,
   "chars": 19
  },
  {
   "text": "持った束の真ん中辺りから",
   "outStart": 33.1,
   "outEnd": 35.43,
   "srcStart": 35.17,
   "srcEnd": 37.51,
   "chars": 12
  },
  {
   "text": "一度ずつ入れていく",
   "outStart": 35.43,
   "outEnd": 38.07,
   "srcStart": 37.5,
   "srcEnd": 40.11,
   "chars": 9
  },
  {
   "text": "1回、2回、3回、4回",
   "outStart": 38.07,
   "outEnd": 41.27,
   "srcStart": 40.1,
   "srcEnd": 43.31,
   "chars": 8
  },
  {
   "text": "4回は多いかもしれないですが",
   "outStart": 41.27,
   "outEnd": 43.2,
   "srcStart": 43.3,
   "srcEnd": 45.24,
   "chars": 14
  },
  {
