 "subtitles": [
  {
   "text": "セルフカットで",
   "outStart": 0.77,
   "outEnd": 1.5,
   "srcStart": 1.73,
   "srcEnd": 2.47,
   "chars": 7
  },
  {
   "text": "伸びて重くなったボブを",
   "outStart": 1.5,
   "outEnd": 3.0,
   "srcStart": 2.47,
   "srcEnd": 3.97,
   "chars": 11
  },
  {
   "text": "軽くしていく際",
   "outStart": 3.0,
   "outEnd": 4.2,
   "srcStart": 3.97,
   "srcEnd": 5.17,
   "chars": 7
  },
  {
   "text": "今後伸ばしていくなら",
   "outStart": 4.77,
   "outEnd": 6.23,
   "srcStart": 6.37,
   "srcEnd": 7.84,
   "chars": 10
  },
  {
   "text": "この場所は",
   "outStart": 6.23,
   "outEnd": 7.1,
   "srcStart": 7.83,
   "srcEnd": 8.71,
   "chars": 5
  },
  {
   "text": "軽くしてはいけない",
   "outStart": 7.1,
   "outEnd": 8.73,
   "srcStart": 8.7,
   "srcEnd": 10.34,
   "chars": 9
  },
  {
   "text": "生え際",
   "outStart": 10.23,
   "outEnd": 11.73,
   "srcStart": 12.3,
   "srcEnd": 13.81,
   "chars": 3
  },
  {
   "text": "横の生え際は",
   "outStart": 11.9,
   "outEnd": 13.1,
   "srcStart": 14.33,
   "srcEnd": 15.54,
   "chars": 6
  },
  {
   "text": "軽くしないようにしておきましょう",
   "outStart": 13.1,
   "outEnd": 15.0,
   "srcStart": 15.53,
   "srcEnd": 17.44,
   "chars": 16
  },
  {
   "text": "生え際を軽くしてしまうと",
   "outStart": 15.07,
   "outEnd": 17.87,
   "srcStart": 17.5,
   "srcEnd": 20.31,
   "chars": 12
  },
  {
   "text": "アレンジしにくくなります",
   "outStart": 18.4,
   "outEnd": 21.53,
   "srcStart": 21.03,
   "srcEnd": 24.41,
   "chars": 12
  },
  {
   "text": "伸びてきた時",
   "outStart": 22.27,
   "outEnd": 23.2,
   "srcStart": 25.13,
   "srcEnd": 26.07,
   "chars": 6
  },
  {
   "text": "肩に当たって跳ねますよね",
   "outStart": 23.2,
   "outEnd": 24.6,
   "srcStart": 26.07,
   "srcEnd": 27.47,
   "chars": 12
  },
  {
   "text": "とにかく落ち着かない",
   "outStart": 25.97,
   "outEnd": 28.13,
   "srcStart": 28.83,
   "srcEnd": 31.01,
   "chars": 10
  },
  {
   "text": "まとまりが悪くなっちゃいます",
   "outStart": 28.2,
   "outEnd": 30.43,
   "srcStart": 31.07,
   "srcEnd": 33.31,
   "chars": 14
  },
  {
   "text": "伸ばしていくのであれば",
   "outStart": 32.9,
   "outEnd": 34.87,
   "srcStart": 36.2,
   "srcEnd": 38.17,
   "chars": 11
  },
  {
   "text": "中の方、軽くするようにやっていきましょうう",
   "outStart": 34.87,
   "outEnd": 37.83,
   "srcStart": 38.17,
   "srcEnd": 41.41,
   "chars": 20
  },
  {
   "text": "後ろ髪の中です",
   "outStart": 38.03,
   "outEnd": 39.67,
   "srcStart": 41.6,
   "srcEnd": 43.24,
   "chars": 7
  },
  {
   "text": "軽くしていくようにやってみてください",
   "outStart": 41.2,
   "outEnd": 44.47,
   "srcStart": 45.03,
   "srcEnd": 48.31,
   "chars": 18
  }
 ],
