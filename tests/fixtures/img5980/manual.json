 "subtitles": [
  {
   "text": "伸びて重くなったギリギリ結べるボブを",
   "outStart": 0.9,
   "outEnd": 4.9,
   "srcStart": 1.57,
   "srcEnd": 5.57,
   "chars": 18
  },
  {
   "text": "セルフで軽くしていく際に、",
   "outStart": 4.9,
   "outEnd": 7.4,
   "srcStart": 5.57,
   "srcEnd": 8.07,
   "chars": 12
  },
  {
   "text": "これをやってしまうと結べなくなります",
   "outStart": 7.4,
   "outEnd": 10.4,
   "srcStart": 8.07,
   "srcEnd": 9.97,
   "chars": 18
  },
  {
   "text": "それは生え際",
   "outStart": 10.4,
   "outEnd": 11.4,
   "srcStart": 12.03,
   "srcEnd": 13.03,
   "chars": 6
  },
  {
   "text": "生え際あたりを",
   "outStart": 11.4,
   "outEnd": 13.3,
   "srcStart": 13.03,
   "srcEnd": 13.07,
   "chars": 7
  },
  {
   "text": "軽くする",
   "outStart": 13.4,
   "outEnd": 14.9,
   "srcStart": 15.37,
   "srcEnd": 16.87,
   "chars": 4
  },
  {
   "text": "やればやるほど結べなくなります",
   "outStart": 15.4,
   "outEnd": 20.4,
   "srcStart": 17.53,
   "srcEnd": 22.4,
   "chars": 15
  },
  {
   "text": "生え際辺りに",
   "outStart": 20.9,
   "outEnd": 21.9,
   "srcStart": 23.5,
   "srcEnd": 24.5,
   "chars": 6
  },
  {
   "text": "細かな短い髪の毛がたくさんできてしまいます",
   "outStart": 21.9,
   "outEnd": 24.9,
   "srcStart": 24.5,
   "srcEnd": 27.5,
   "chars": 21
  },
  {
   "text": "それによって結びにくいですし、結んでいても",
   "outStart": 25.4,
   "outEnd": 28.4,
   "srcStart": 28.0,
   "srcEnd": 31.0,
   "chars": 20
  },
  {
   "text": "結んでいても",
   "outStart": 28.4,
   "outEnd": 29.4,
   "srcStart": 31.0,
   "srcEnd": 31.83,
   "chars": 6
  },
  {
   "text": "落ちてしまいやすいです",
   "outStart": 29.9,
   "outEnd": 32.9,
   "srcStart": 32.8,
   "srcEnd": 35.7,
   "chars": 11
  },
  {
   "text": "ギリギリ結べるようになったボブを",
   "outStart": 32.9,
   "outEnd": 35.9,
   "srcStart": 39.93,
   "srcEnd": 42.93,
   "chars": 16
  },
  {
   "text": "軽くしていく際",
   "outStart": 35.9,
   "outEnd": 36.9,
   "srcStart": 42.93,
   "srcEnd": 43.93,
   "chars": 7
  },
  {
   "text": "中の方をメインで",
   "outStart": 37.4,
   "outEnd": 39.4,
   "srcStart": 44.77,
   "srcEnd": 46.77,
   "chars": 8
  },
  {
   "text": "軽くするようにやっていきましょう",
   "outStart": 39.4,
   "outEnd": 41.4,
   "srcStart": 46.77,
   "srcEnd": 48.77,
   "chars": 16
  },
  {
   "text": "上と下はあまり軽くしないです",
   "outStart": 41.9,
   "outEnd": 45.9,
   "srcStart": 49.27,
   "srcEnd": 53.27,
   "chars": 14
  },
  {
   "text": "横髪、後ろ髪ともにです",
   "outStart": 45.9,
   "outEnd": 48.4,
   "srcStart": 53.27,
   "srcEnd": 55.77,
   "chars": 10
  },
  {
   "text": "特に軽くしていい場所は",
   "outStart": 48.4,
   "outEnd": 49.9,
   "srcStart": 55.77,
   "srcEnd": 55.97,
   "chars": 11
  },
  {
   "text": "後ろ髪の真ん中の辺りです",
   "outStart": 49.9,
   "outEnd": 52.4,
   "srcStart": 58.16,
   "srcEnd": 60.66,
   "chars": 12
  },
  {
   "text": "軽くする際はここを中心にやってみてください",
   "outStart": 52.4,
   "outEnd": 56.0,
   "srcStart": 60.66,
   "srcEnd": 60.77,
   "chars": 21
  }
 ],
