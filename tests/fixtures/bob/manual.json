 "subtitles": [
  {
   "text": "セルフカットで",
   "outStart": 0.8,
   "outEnd": 1.6,
   "srcStart": 0.8,
   "srcEnd": 1.6,
   "chars": 7
  },
  {
   "text": "伸びて重くなったボブを軽くしていく際",
   "outStart": 1.6,
   "outEnd": 5.47,
   "srcStart": 1.6,
   "srcEnd": 5.47,
   "chars": 18
  },
  {
   "text": "この場所は絶対にすかないでください",
   "outStart": 5.5,
   "outEnd": 8.1,
   "srcStart": 5.5,
   "srcEnd": 8.1,
   "chars": 17
  },
  {
   "text": "それはどこなのか",
   "outStart": 8.17,
   "outEnd": 9.37,
   "srcStart": 8.17,
   "srcEnd": 9.1,
   "chars": 8
  },
  {
   "text": "トップの根元付近です",
   "outStart": 9.6,
   "outEnd": 12.83,
   "srcStart": 9.57,
   "srcEnd": 12.8,
   "chars": 10
  },
  {
   "text": "この場所を軽くしてしまうと、",
   "outStart": 13.03,
   "outEnd": 16.37,
   "srcStart": 13.0,
   "srcEnd": 16.3,
   "chars": 13
  },
  {
   "text": "アホ毛のようなピンピンした髪の毛がたくさんできてしまう",
   "outStart": 16.43,
   "outEnd": 20.73,
   "srcStart": 16.89,
   "srcEnd": 21.19,
   "chars": 27
  },
  {
   "text": "まとまりつかないようになってしまいます",
   "outStart": 21.07,
   "outEnd": 23.5,
   "srcStart": 21.53,
   "srcEnd": 23.96,
   "chars": 19
  },
  {
   "text": "傷んでも見えやすいです",
   "outStart": 23.97,
   "outEnd": 26.23,
   "srcStart": 24.43,
   "srcEnd": 26.69,
   "chars": 11
  },
  {
   "text": "こうなってしまうと髪の毛が伸びないと修正カットができないです",
   "outStart": 26.4,
   "outEnd": 31.53,
   "srcStart": 26.86,
   "srcEnd": 26.9,
   "chars": 30
  },
  {
   "text": "下手すれば半年以上伸ばし続けないと",
   "outStart": 31.57,
   "outEnd": 34.87,
   "srcStart": 32.67,
   "srcEnd": 34.37,
   "chars": 17
  },
  {
   "text": "うまくカバーできません",
   "outStart": 35.8,
   "outEnd": 38.2,
   "srcStart": 37.24,
   "srcEnd": 39.64,
   "chars": 11
  },
  {
   "text": "となれば、トップ表面の根元付近は軽くしない",
   "outStart": 38.43,
   "outEnd": 42.2,
   "srcStart": 39.87,
   "srcEnd": 43.64,
   "chars": 20
  },
  {
   "text": "それを頭に入れてセルフカットをやってみてください",
   "outStart": 42.47,
   "outEnd": 46.07,
   "srcStart": 43.91,
   "srcEnd": 47.51,
   "chars": 24
  }
 ],
