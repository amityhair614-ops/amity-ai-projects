   "outEnd": 4.9,
   "srcStart": 5.07,
   "srcEnd": 5.91,
   "chars": 10
  },
  {
   "text": "ガタガタになってしまうこと",
   "outStart": 4.9,
   "outEnd": 6.67,
   "srcStart": 5.9,
   "srcEnd": 7.67,
   "chars": 13
  },
  {
   "text": "左右何度も同じように切り進める",
   "outStart": 7.77,
   "outEnd": 12.0,
   "srcStart": 8.83,
   "srcEnd": 13.57,
   "chars": 15
  },
  {
   "text": "どういうことかというと",
   "outStart": 12.03,
   "outEnd": 12.87,
   "srcStart": 13.6,
   "srcEnd": 14.44,
   "chars": 11
  },
  {
   "text": "右を切った",
   "outStart": 12.87,
   "outEnd": 14.67,
   "srcStart": 14.43,
   "srcEnd": 16.24,
   "chars": 5
  },
  {
   "text": "次",
   "outStart": 14.67,
   "outEnd": 15.47,
   "srcStart": 16.23,
   "srcEnd": 17.07,
   "chars": 1
  },
  {
   "text": "左を切った",
   "outStart": 15.67,
   "outEnd": 16.67,
   "srcStart": 17.27,
   "srcEnd": 18.31,
   "chars": 5
  },
  {
   "text": "次また右、また左",
   "outStart": 16.67,
   "outEnd": 19.1,
   "srcStart": 18.3,
   "srcEnd": 20.87,
   "chars": 7
  },
  {
   "text": "これを何度も繰り返していくと",
   "outStart": 19.6,
   "outEnd": 22.3,
   "srcStart": 21.47,
   "srcEnd": 24.21,
   "chars": 14
  },
  {
   "text": "気づけば",
   "outStart": 23.0,
   "outEnd": 23.47,
   "srcStart": 25.07,
   "srcEnd": 25.54,
   "chars": 4
  },
  {
   "text": "長さが短くなって",
   "outStart": 23.47,
   "outEnd": 24.77,
   "srcStart": 25.53,
   "srcEnd": 26.84,
   "chars": 8
  },
  {
   "text": "毛先ガタガタになってしまいます",
   "outStart": 24.77,
   "outEnd": 27.4,
   "srcStart": 26.83,
   "srcEnd": 30.61,
   "chars": 15
  },
  {
   "text": "目印をつける",
   "outStart": 29.37,
   "outEnd": 30.7,
   "srcStart": 32.57,
   "srcEnd": 33.91,
   "chars": 6
  },
  {
   "text": "ヘアクリップなどで",
   "outStart": 30.97,
   "outEnd": 32.8,
   "srcStart": 34.17,
   "srcEnd": 36.01,
   "chars": 9
  },
  {
   "text": "残したい長さに留めておく",
   "outStart": 32.8,
   "outEnd": 36.1,
   "srcStart": 36.0,
   "srcEnd": 39.31,
   "chars": 12
  },
  {
   "text": "反対側の横にも同じように留めておいて",
   "outStart": 36.5,
   "outEnd": 40.77,
   "srcStart": 39.7,
   "srcEnd": 44.61,
   "chars": 18
  },
  {
   "text": "ヘアクリップの位置合っているか？",
   "outStart": 40.8,
   "outEnd": 42.43,
   "srcStart": 44.63,
   "srcEnd": 46.27,
   "chars": 16
  },
  {
   "text": "チェックして",
