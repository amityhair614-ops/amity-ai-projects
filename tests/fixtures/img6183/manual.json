   "outEnd": 43.27,
   "srcStart": 46.27,
   "srcEnd": 47.11,
   "chars": 6
  },
  {
   "text": "良ければ",
   "outStart": 43.47,
   "outEnd": 44.07,
   "srcStart": 47.3,
   "srcEnd": 47.91,
   "chars": 4
  },
  {
   "text": "ヘアクリップの下",
   "outStart": 44.07,
   "outEnd": 45.87,
   "srcStart": 47.9,
   "srcEnd": 49.71,
   "chars": 8
  },
  {
   "text": "毛先に当たるところを少しずつ切っていくです",
   "outStart": 45.87,
   "outEnd": 48.37,
   "srcStart": 49.7,
   "srcEnd": 52.21,
   "chars": 21
  },
  {
   "text": "左右は合います",
   "outStart": 49.87,
   "outEnd": 51.63,
   "srcStart": 53.7,
   "srcEnd": 55.47,
   "chars": 7
  },
  {
   "text": "ガタガタになりにくいです",
